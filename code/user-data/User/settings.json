{
	// #region editor config
	"[css]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[html]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[java]": {
		"editor.defaultFormatter": "redhat.java"
	},
	"[javascript]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[javascriptreact]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[json]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[python]": {
		"editor.defaultFormatter": "ms-python.black-formatter"
	},
	"[ruby]": {
		"editor.defaultFormatter": "Shopify.ruby-lsp",
		"files.insertFinalNewline": true
	},
	"[typescript]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"editor.acceptSuggestionOnEnter": "off",
	"editor.bracketPairColorization.enabled": true,
	"editor.fontFamily": "'Hack', monospace",
	"editor.fontSize": 14,
	"editor.insertSpaces": false,
	"editor.lineNumbers": "on",
	"editor.snippetSuggestions": "top",
	"editor.tabCompletion": "on",
	"editor.tabSize": 4,
	"explorer.confirmDragAndDrop": false,
	"files.exclude": {
		"**/.DS_Store": false,
		"**/.git": false,
		"**/.hg": false,
		"**/.svn": false,
		"**/CVS": false,
		"**/.classpath": false,
		"**/.project": false,
		"**/.settings": false,
		"**/.factorypath": false,
		"**/Thumbs.db": false
	},
	"react-native-tools.networkInspector.consoleLogsColorTheme": "Dark",
	"search.exclude": {
		"**/.git": true,
		"**/.svn": true
	},
	"window.customMenuBarAltFocus": false,
	"window.enableMenuBarMnemonics": false,
	"window.menuBarVisibility": "compact",
	"window.title": "${rootName}${separator}${activeEditorShort}${separator}${appName}",
	"window.titleBarStyle": "custom",
	"window.titleSeparator": " 🐱 ",
	"workbench.editorAssociations": {
		"*.ipynb": "default",
		"*.pdf": "pdf.preview"
	},
	"workbench.enableExperiments": false,
	"workbench.iconTheme": "material-icon-theme",
	"workbench.settings.enableNaturalLanguageSearch": false,
	"vim.foldfix": true,
	// #endregion

	// #region gitlens
	"gitlens.codeLens.enabled": false,
	"gitlens.currentLine.enabled": false,
	"gitlens.defaultDateFormat": "YYYY/MM/DD, h:mma",
	"gitlens.defaultDateShortFormat": "YYYY/MM/DD",
	"gitlens.defaultDateStyle": "absolute",
	"gitlens.defaultTimeFormat": "h:mma",
	"gitlens.hovers.currentLine.over": "line",
	"gitlens.hovers.enabled": false,
	// #endregion

	// #region html format
	"html.format.contentUnformatted": "pre,code,textarea",
	"html.format.endWithNewline": true,
	"html.format.extraLiners": "head, body, /html",
	"html.format.indentHandlebars": false,
	"html.format.indentInnerHtml": false,
	"html.format.maxPreserveNewLines": null,
	"html.format.preserveNewLines": false,
	"html.format.wrapAttributes": "auto",
	"html.format.wrapLineLength": 80,
	// #endregion

	// #region java
	"java.configuration.runtimes": [

		{
			"name": "JavaSE-1.8",
			"path": "/usr/lib/jvm/java-8-openjdk/",
			"default": false
		}
	],
	"java.jdt.ls.java.home": "/usr/lib/jvm/default-runtime/",
	"java.project.importOnFirstTimeStartup": "automatic",
	// #endregion

	// #region latex
	"latex-workshop.bibtex-format.tab": "tab",
	"latex-workshop.latex.recipes": [
		{
			"name": "pog",
			"tools": ["pdf"]
		}
	],
	"latex-workshop.latex.tools": [
		{
			"name": "pdf",
			"command": "pdf",
			"args": ["%DOC_EXT%"],
			"env": {}
		}
	],
	"latex-workshop.view.pdf.viewer": "tab",
	// #endregion

	// #region liveshare config
	"liveshare.allowGuestDebugControl": true,
	"liveshare.allowGuestTaskControl": true,
	"liveshare.anonymousGuestApproval": "accept",
	"liveshare.diagnosticLogging": true,
	"liveshare.diagnosticMode": true,
	"liveshare.openSharedServers": false,
	"liveshare.populateGitCoAuthors": "never",
	"liveshare.sharedTerminalHeight": 100,
	"liveshare.sharedTerminalWidth": 200,
	"liveshare.showReadOnlyUsersInEditor": "always",
	// #endregion

	// #region prettier config
	"prettier.enableDebugLogs": true,
	"prettier.printWidth": 80,
	"prettier.trailingComma": "none",
	"redhat.telemetry.enabled": false,
	// #endregion

	// #region telemetry
	"extensions.autoUpdate": false,
	"extensions.autoCheckUpdates": false,
	// "telemetry.enableCrashReporter": false,
	// "telemetry.enableTelemetry": false,
	"telemetry.telemetryLevel": "off",
	// #endregion

	"editor.suggestSelection": "first",
	"vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
	"files.associations": {
		"*.rmd": "markdown",
		"*.css": "css"
	},
	"r.alwaysUseActiveTerminal": true,
	"r.plot.defaults.colorTheme": "vscode",
	"r.rpath.linux": "/usr/bin/R",
	"r.rterm.linux": "/usr/bin/R",
	"svelte.enable-ts-plugin": true,
	"[svelte]": {
		"editor.defaultFormatter": "svelte.svelte-vscode"
	},
	"workbench.startupEditor": "none",
	"[typescriptreact]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[markdown]": {
		"editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
	},
	"editor.unicodeHighlight.nonBasicASCII": false,
	"fx-extension.prerequisiteCheck": {
		"ngrok": false
	},
	"terminal.integrated.enableMultiLinePasteWarning": "never",
	"latex-workshop.latex.autoBuild.run": "onSave",
	"workbench.colorTheme": "Dark Pink",
	"editor.largeFileOptimizations": false,
	"boot-java.rewrite.reconcile": true,
	"window.zoomLevel": 1,
	"workbench.editor.empty.hint": "hidden",
	"editor.cursorSmoothCaretAnimation": "on",
	"editor.cursorBlinking": "phase",
	"editor.inlayHints.enabled": "offUnlessPressed",
	"rust-analyzer.inlayHints.maxLength": null,
	"rubyLsp.formatter": "rubocop",
	"terminal.integrated.allowChords": false,
	"cmake.pinnedCommands": [
		"workbench.action.tasks.configureTaskRunner",
		"workbench.action.tasks.runTask"
	],
	"python.languageServer": "Pylance",
	"python.defaultInterpreterPath": "/home/penguin/files/git/venv-python3.13/bin/python",
	"debug.inlineValues": "on",
	"debugpy.showPythonInlineValues": true,
	"gitlens.home.preview.enabled": false,
	"remote.defaultExtensionsIfInstalledLocally": [
		"GitHub.copilot",
		"GitHub.copilot-chat",
		"GitHub.vscode-pull-request-github"
	],
	"github.copilot.enable": {
		"*": false,
		"plaintext": false,
		"markdown": false,
		"scminput": false
	},
	"powermode.combo.location": "off",
	"powermode.enabled": true,
}
